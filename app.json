{
  "expo": {
    "name": "Cyclic",
    "slug": "cyclic-trivia",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "scheme": "cyclic",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070B1F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cyclictrivia.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cyclictrivia.app",
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#070B1F"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/withDevHttps",
      "./plugins/withReleaseSigning",
      "./plugins/withOptionalHardware",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#070B1F",
          "dark": {
            "image": "./assets/splash-logo.png",
            "backgroundColor": "#070B1F"
          }
        }
      ],
      "expo-secure-store",
      "expo-screen-orientation",
      "expo-video",
      "expo-iap",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#070B1F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cyclic uses the camera to scan the room QR code and to show you on video chat with the players in your room.",
          "recordAudioAndroid": false
        }
      ],
      "expo-audio",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Cyclic uses the camera to scan the room QR code and to show you on video chat with the players in your room.",
          "microphonePermission": "Cyclic uses the microphone so the players in your room can hear you on video chat."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "223bdf69-2c75-4e34-ae0b-51ec27dc9823"
      }
    }
  }
}
